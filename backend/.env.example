# Django Configuration
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-render-app.onrender.com

# Database Configuration (Neon PostgreSQL)
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password-here
DB_HOST=your-neon-host.us-east-2.aws.neon.tech
DB_PORT=5432
PGSSLMODE=require
PGCHANNELBINDING=require

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=0
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
